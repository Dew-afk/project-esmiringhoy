# Database — verified against PostgreSQL 16 (docker compose up -d, port 5433
# because a native postgres service already owns 5432 on this machine):
DATABASE_URL=postgresql+psycopg://aism:aism-dev@localhost:5433/aism
# Fallback without Docker (feature-complete, same migrations):
# DATABASE_URL=sqlite:///./aism.db

# REQUIRED in production — used for JWT signing and download tokens
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MIN=480

# Allowed browser origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Token the ML bridge / trusted ingestion uses (X-ML-Token header)
ML_INGEST_TOKEN=change-me-too

# Directory the webcam_demo.py server writes live_*.jsonl files into
ML_EVENTS_DIR=../machine learning/events

# Recording storage. "local" = development adapter only (plaintext files,
# never production). Production: S3-compatible provider.
STORAGE_PROVIDER=local
STORAGE_DIR=./storage

# Advisory LLM summarizer (OpenAI-compatible /chat/completions endpoint).
# Left empty, the summary API returns 503 "unavailable" — never fabricated.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Retention: 0 = not configured (purge job does nothing). Set explicit days.
RETENTION_DAYS_DEFAULT=0

# Risk scoring severity weights — UNNAPPROVED implementation defaults until
# the team adopts them; keep traceable (see docs/ARCHITECTURE.md).
RISK_WEIGHTS=low:2,medium:8,high:20,critical:50

# Event queue — db (default) or redis (reliable-queue pattern; verified)
QUEUE_BACKEND=db
REDIS_URL=redis://localhost:6379/0
QUEUE_MAX_RETRIES=3
QUEUE_POLL_S=1.0

# Login rate limit — strict default; raise for local dev/integration runs
LOGIN_RATE_LIMIT=5/minute

# Bootstrap admin (scripts/bootstrap.py) — only used for local development
BOOTSTRAP_ADMIN_EMAIL=admin@aism.local
BOOTSTRAP_ADMIN_PASSWORD=change-this-too
