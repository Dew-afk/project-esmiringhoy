# ML inference demo server (FastAPI, machine learning/webcam_demo.py)
NEXT_PUBLIC_ML_WS_URL=ws://127.0.0.1:8000/ws

# Future backend API base — not implemented yet; services read deterministic
# demo fixtures until this backend exists (see UI_IMPLEMENTATION.md).
