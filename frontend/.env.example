# ML inference demo server (FastAPI, machine learning/webcam_demo.py)
NEXT_PUBLIC_ML_WS_URL=ws://127.0.0.1:8000/ws

# AIsmering backend API (backend/app — FastAPI). See backend/.env.example.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8010/api/v1

# true = talk to the real backend (must be running; see docs/START_HERE.md).
# false = deterministic demo fixtures for the UI.
NEXT_PUBLIC_API_ENABLED=false

# Demo mode: true = show clearly labeled development fixtures and demo auth.
# Set false for any production-like deployment (fixtures disappear, features
# without a backend show unavailable states).
NEXT_PUBLIC_DEMO_MODE=true
