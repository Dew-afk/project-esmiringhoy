# AIsmering database environment — copy to .env and fill the placeholders.
# Never commit the real .env, and never log these values.
#
# The database is a LOCAL PostgreSQL instance. NEVER use the default native
# PostgreSQL on port 5432 unless it is this project's dedicated instance.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aismering
POSTGRES_USER=aismering_app
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# Convenience connection string (same placeholders):
DATABASE_URL=postgresql://aismering_app:CHANGE_ME_strong_password@localhost:5432/aismering

# Alembic will read this URL; keep credentials out of logs and code.
